{
  "schemaVersion": 1,
  "id": "team-view-relay",
  "version": "${version}",

  "name": "TeamViewRelay",
  "description": "用于团队协同作战的视野与报点共享系统。支持同步玩家位置、实体信息、共享路标，可与 Xaero Minimap/World Map 和 journeymap 联动。该项目需自建服务器来实现视野信息的传递，详情请看主页介绍。",
  "authors": ["Prof. Chen"],
  "contact": {
    "homepage": "https://github.com/MC-TeamViewer/Minecraft_TeamViewer",
    "sources": "https://github.com/MC-TeamViewer/Minecraft_TeamViewer",
    "issues": "https://github.com/MC-TeamViewer/Minecraft_TeamViewer/issues"
  },

  "license": "MIT",
  "icon": "assets/teamviewer/icon.ico",

  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "fun.prof_chen.teamviewer.client.TeamviewerDataGenerator"
    ],
    "client": [
      "fun.prof_chen.teamviewer.client.TeamviewerClient"
    ],
    "journeymap": [
      "fun.prof_chen.teamviewer.main_code.mapbridge.provider.journey.JourneyMapClientPlugin"
    ],
    "modmenu": [
      "fun.prof_chen.teamviewer.client.TeamviewerModMenuApi"
    ]
  },

  "mixins": [
    "teamviewer.mixins.json"
    ,{
      "config": "teamviewer.client.mixins.json",
      "environment": "client"
    }
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "${fabric_api_mod_id}": "*",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
